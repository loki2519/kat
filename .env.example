# KAT Corporate Server Environment Configuration Template
PORT=5000

# Razorpay Test / Live API Keys (Do NOT commit real keys to version control)
# Frontend environment key (public key ID)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Backend environment keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# Database & Authentication
DATABASE_URL=./kat_database.sqlite
ADMIN_SESSION_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
